{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/es",
      "destination": "/index.html"
    },
    {
      "source": "/es/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/project/(.*)",
      "destination": "/index.html"
    }
  ]
}